# Android emulator -> local XAMPP:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2/cfts/api
# Physical device (Expo Go) -> your PC LAN IP:
EXPO_PUBLIC_API_BASE_URL=http://192.168.8.112/cfts/api
# Production (pretty URLs, after mod_rewrite is enabled):
# EXPO_PUBLIC_API_BASE_URL=https://c-familia.online/api
# Production fallback when the host ignores .htaccess rewrites:
# EXPO_PUBLIC_API_BASE_URL=https://c-familia.online/api/index.php
# EXPO_PUBLIC_API_QUERY_ROUTES=1